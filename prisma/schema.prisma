// FitPro GYM App — Prisma schema (SQLite).
// Mirrors the domain model of the reference app (base44 entities):
// User, Membership plans, Shop products, CartItems per user, Orders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Login users (email + password). The reference app stores the display
// name as full_name; we keep `name` and expose it as full_name in the API.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Membership plans ("Membership" entity in the reference app).
// features: the reference stores a JSON array of strings; SQLite has no
// native scalar lists, so it is kept as a JSON string and (de)serialized at
// the API boundary (src/lib/serialize.ts).
model MembershipPlan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  price         Float
  durationMonths Int    @default(1)
  features      String   @default("[]")
  popular       Boolean  @default(false)
  colorScheme   String   @default("blue") // blue | green | purple | orange
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Shop products ("Product" entity).
model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  price         Float
  category      String   @default("equipment") // supplements | equipment | accessories | ...
  imageUrl      String?
  stockQuantity Int      @default(0)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([featured])
}

// Per-user cart lines ("CartItem" entity). The reference deduplicates
// (user_email, item_type, item_id) in application code by checking before
// insert and bumping quantity — we keep the same app-level logic and make
// the pair unique at the storage layer too for defense in depth.
model CartItem {
  id        String   @id @default(cuid())
  userEmail String
  itemType  String // "product" | "membership"
  itemId    String
  itemName  String
  price     Float
  quantity  Int      @default(1)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userEmail, itemType, itemId])
  @@index([userEmail])
}

// Placed orders ("Order" entity). items and shippingAddress are JSON
// strings mirroring the reference shapes:
//   items:          [{ name, type, price, quantity }]
//   shippingAddress: { street, city, state, zip }
model Order {
  id              String   @id @default(cuid())
  userEmail       String
  totalAmount     Float
  items           String // JSON array of {name, type, price, quantity}
  shippingAddress String // JSON object {street, city, state, zip}
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@index([userEmail])
  @@index([createdAt])
}
